# Copy this file to .env and adjust as needed. All services in docker-compose.yml read from .env.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce
MYSQL_PASSWORD=ecommerce
DATABASE_URL=mysql://ecommerce:ecommerce@mysql:3306/ecommerce

# --- Backend (NestJS) ---
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
FLAT_TAX_RATE=0.08
FLAT_SHIPPING_RATE=5.00
FRONTEND_URL=http://localhost:3000

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=product-images
MINIO_PUBLIC_URL=http://localhost:9000

# --- Mail (Mailpit fake SMTP) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@ecommerce.local

# --- Stripe (test/sandbox mode) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Server-side (SSR, inside the frontend container) reaches the backend via the Docker network.
INTERNAL_API_URL=http://backend:4000
